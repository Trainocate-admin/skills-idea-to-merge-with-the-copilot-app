---
// Bookmarks component.
//
// The markup below renders during the static build. The dynamic behavior —
// adding a bookmark, generating a short slug, and persisting to the browser —
// runs ONLY in the client-side <script> boundary at the bottom of this
// file. Astro bundles that script for the browser and never executes it
// during the build, so browser-only APIs (localStorage) are safe there.
---
<form id="add-bookmark">
  <div class="field">
    <label for="url">Link to save</label>
    <input
      id="url"
      name="url"
      type="text"
      inputmode="url"
      autocomplete="off"
      spellcheck="false"
      placeholder="https://example.com"
      required
    />
  </div>
  <button type="submit">Add bookmark</button>
</form>

<p class="hint">Paste a URL and select <strong>Add bookmark</strong> to generate its short <code>mona-</code> slug.</p>

<p id="empty-state" class="empty">No bookmarks yet — add your first link above.</p>

<div id="list-header" hidden>
  <h2 class="list-title">Saved bookmarks</h2>
  <button id="clear-all" type="button" class="clear">Clear all</button>
</div>

<ul id="bookmark-list" aria-label="Saved bookmarks" aria-live="polite">
  <!-- Bookmarks render here in the browser. -->
</ul>

<script>
  // CLIENT-SIDE BOUNDARY — runs in the browser only.
  // Because this code lives in a client <script>, browser storage APIs are
  // safe to use here without breaking the static build. The pure logic
  // (normalising URLs, generating slugs, and parsing/validating whatever is
  // in storage) lives in ../lib/bookmarks so it can be unit tested without a
  // browser; this file only wires that logic up to the DOM and localStorage.
  import {
    SEPARATOR,
    STORAGE_KEY,
    generateSlug,
    normalizeUrl,
    parseStoredBookmarks,
    serializeBookmarks,
    type Bookmark,
  } from '../lib/bookmarks';

  const form = document.getElementById('add-bookmark') as HTMLFormElement | null;
  const urlInput = document.getElementById('url') as HTMLInputElement | null;
  const list = document.getElementById('bookmark-list');
  const emptyState = document.getElementById('empty-state');
  const listHeader = document.getElementById('list-header');
  const clearAllButton = document.getElementById('clear-all');

  function loadBookmarks(): Bookmark[] {
    // localStorage is untrusted: it may be empty, corrupted, hand-edited, or
    // left over from a previous version of this app. parseStoredBookmarks
    // never throws and always hands back a clean array of valid bookmarks.
    let raw: string | null = null;
    try {
      raw = localStorage.getItem(STORAGE_KEY);
    } catch {
      // Storage can be unavailable (e.g. disabled, private browsing quirks).
      raw = null;
    }
    return parseStoredBookmarks(raw);
  }

  function saveBookmarks(bookmarks: Bookmark[]): void {
    try {
      localStorage.setItem(STORAGE_KEY, serializeBookmarks(bookmarks));
    } catch {
      // Ignore write failures (e.g. storage full or disabled); the in-memory
      // render still reflects the user's action for this page view.
    }
  }

  function render(bookmarks: Bookmark[]): void {
    if (!list || !emptyState || !listHeader) return;
    list.innerHTML = '';

    const hasBookmarks = bookmarks.length > 0;
    emptyState.hidden = hasBookmarks;
    listHeader.hidden = !hasBookmarks;

    for (const bookmark of bookmarks) {
      const item = document.createElement('li');
      item.className = 'bookmark';

      const link = document.createElement('a');
      link.className = 'url';
      link.href = bookmark.url;
      link.target = '_blank';
      link.rel = 'noopener noreferrer';
      link.textContent = bookmark.url;

      const separator = document.createElement('span');
      separator.className = 'separator';
      separator.setAttribute('aria-hidden', 'true');
      separator.textContent = SEPARATOR;

      const slug = document.createElement('span');
      slug.className = 'slug';
      slug.textContent = bookmark.slug;

      const copyButton = document.createElement('button');
      copyButton.type = 'button';
      copyButton.className = 'copy';
      copyButton.textContent = 'Copy';
      copyButton.setAttribute('aria-label', `Copy short link ${bookmark.slug}`);
      copyButton.addEventListener('click', async () => {
        try {
          await navigator.clipboard.writeText(bookmark.slug);
          const original = copyButton.textContent;
          copyButton.textContent = 'Copied!';
          setTimeout(() => {
            copyButton.textContent = original;
          }, 1500);
        } catch {
          // Clipboard API unavailable or permission denied — ignore silently.
        }
      });

      item.append(link, separator, slug, copyButton);
      list.append(item);
    }
  }

  function addBookmark(url: string): void {
    const bookmarks = loadBookmarks();
    const existingSlugs = new Set(bookmarks.map((b) => b.slug));
    const slug = generateSlug(existingSlugs);
    bookmarks.unshift({ url, slug });
    saveBookmarks(bookmarks);
    render(bookmarks);
  }

  form?.addEventListener('submit', (event) => {
    event.preventDefault(); // keep this FIRST — stops the page from reloading

    try {
      const url = normalizeUrl(urlInput?.value ?? '');
      if (!url) {
        urlInput?.setAttribute('aria-invalid', 'true');
        urlInput?.reportValidity();
        return;
      }

      urlInput?.removeAttribute('aria-invalid');
      addBookmark(url);
      form.reset();
      urlInput?.focus();
    } catch {
      // Whatever goes wrong here, the page must never fall back to a native
      // submit/reload — preventDefault() above has already guaranteed that.
    }
  });

  clearAllButton?.addEventListener('click', () => {
    if (!confirm('Remove all saved bookmarks?')) return;
    saveBookmarks([]);
    render([]);
  });

  // On page load, read the saved bookmarks from storage and render them so
  // the list persists across reloads.
  render(loadBookmarks());
</script>
